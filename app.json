{
  "expo": {
    "name": "Capshion",
    "slug": "capshion",
    "owner": "furkan1010",
    "sdkVersion": "57.0.0",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "capshion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F2F2F7",
      "bundleIdentifier": "com.furkan.capshion",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Capshion requires camera access to analyze your photos and generate premium, tailored social media captions.",
        "NSPhotoLibraryUsageDescription": "Capshion requires photo library access to let you select images for professional caption generation.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#F2F2F7",
      "package": "com.furkan.capshion",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A84FF",
          "sounds": [
            "./assets/sounds/capshion_sound.wav"
          ]
        }
      ],
      "expo-image",
      "./plugins/withCleartextTraffic.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cf6210e-3a3c-4895-9850-8933aa9458c4"
      }
    }
  }
}

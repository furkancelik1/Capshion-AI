{
  "expo": {
    "name": "Capshion",
    "slug": "capshion",
    "owner": "furkan1010",
    "sdkVersion": "57.0.0",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "capshion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "backgroundColor": "#F2F2F7",
      "bundleIdentifier": "com.furkan.capshion",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "12",
      "infoPlist": {
        "NSCameraUsageDescription": "Capshion uses the camera so you can take the photo you want captions for.",
        "NSPhotoLibraryUsageDescription": "Capshion uses your photo library so you can pick the photos you want captions for.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#F2F2F7",
      "package": "com.furkan.capshion",
      "versionCode": 45,
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A84FF",
          "sounds": [
            "./assets/sounds/capshion_sound.wav"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6029770395883794~1220859464",
          "iosAppId": "ca-app-pub-6029770395883794~9896128669",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This permission is only used to show you more relevant ads. All features work even if you don't allow it."
        }
      ],
      "expo-image",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withRNFirebaseDisableSPM.js",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This permission is only used to show you more relevant ads. All features work even if you don't allow it."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cf6210e-3a3c-4895-9850-8933aa9458c4"
      }
    },
    "locales": {
      "en": "./languages/en.json",
      "tr": "./languages/tr.json"
    }
  }
}

{
  "expo": {
    "name": "Capshion",
    "slug": "capshion",
    "owner": "furkan1010",
    "sdkVersion": "57.0.0",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "capshion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F2F2F7",
      "bundleIdentifier": "com.furkan.capshion",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Capshion requires camera access to analyze your photos and generate premium, tailored social media captions.",
        "NSPhotoLibraryUsageDescription": "Capshion requires photo library access to let you select images for professional caption generation.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#F2F2F7",
      "package": "com.furkan.capshion",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/images/logo.png",
            "backgroundColor": "#F2F2F7"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A84FF",
          "sounds": [
            "./assets/sounds/capshion_sound.wav"
          ]
        }
      ],
      "expo-image",
      "./plugins/withCleartextTraffic.js",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1cf6210e-3a3c-4895-9850-8933aa9458c4"
      }
    }
  }
}

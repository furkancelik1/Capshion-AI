# ─────────────────────────────────────────────────────────────
# Backend (server.js) — Railway'de Variables sekmesine girilir
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/capshion
JWT_SECRET=change-me-to-a-64-char-random-string

# Yüklenen görsellerin dışarıdan erişilen kök adresi (sonunda / olmadan).
# Boş bırakılırsa isteğin Host başlığı kullanılır. Production: https://<railway-domain>
PUBLIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# RevenueCat webhook doğrulaması
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# CORS (virgülle ayrılmış origin listesi)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Yükleme limitleri
MAX_FILE_SIZE=10485760
MAX_FILES=5

# ─────────────────────────────────────────────────────────────
# Expo (frontend) — EXPO_PUBLIC_* değerleri uygulama paketine gömülür,
# buraya asla gizli anahtar koyma. Production build'ler bu değerleri
# .env'den değil EAS ortam değişkenlerinden (environment: production) alır.
# ─────────────────────────────────────────────────────────────
# Geliştirmede boş bırakılırsa emülatör adresine (10.0.2.2 / localhost:3000) düşer.
# Production'da zorunlu: https://<railway-domain>/api
EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_POSTHOG_API_KEY=phc_your-project-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

EXPO_PUBLIC_RC_APPLE_KEY=appl_your-public-sdk-key
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_your-public-sdk-key

# Google Sign-In (Firebase / Google Cloud Console OAuth Web Client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ─── Ödüllü reklam (routes/ads.js) ───
# Railway (canlı): ADS_REWARDED_ENABLED=true ve ADMOB_REWARDED_AD_UNIT_IDS
ADS_REWARDED_ENABLED=false
ADS_DAILY_LIMIT=3
ADS_REWARD_CREDITS=1
ADMOB_REWARDED_AD_UNIT_IDS=
# YALNIZCA YEREL: test reklamları SSV göndermez; krediyi bu verir (production'da çalışmaz)
ADS_DEV_REWARD=false

# ─── Günlük ritim (routes/daily.js) ───
# Railway (canlı): DAILY_PUSH_ENABLED=true ve rastgele uzun bir DAILY_CRON_SECRET
DAILY_PUSH_ENABLED=false
DAILY_STREAK_HOUR=20
DAILY_CRON_SECRET=
# DAILY_IDEA_MODEL=gpt-4o

# ─── Caption prompt sürümü (prompts/) ───
# Sorun olursa v1 yapıp yeniden başlat
CAPTION_PROMPT_VERSION=v3

# ─── Uygulama (EAS ortam değişkenleri; build'e gömülür) ───
# EXPO_PUBLIC_HOOK_LAB=true
# EXPO_PUBLIC_REWARDED_ADS=true
# EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-.../...
# EXPO_PUBLIC_DAILY_RITUAL=true

# ─── Hesap silme (routes/account.js) ───
# Web silme sayfasında (/hesap-silme) gösterilecek destek e-postası
SUPPORT_EMAIL=
# Apple ile girişte hesap silinince Apple token'larını iptal etmek için (App Store zorunluluğu).
# Apple Developer → Keys → "Sign in with Apple" anahtarı (.p8). Boşsa iptal atlanır, hesap yine silinir.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
